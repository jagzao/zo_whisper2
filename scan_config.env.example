# Configuración para scan_and_process.py
# Copia este archivo a .env o configura estas variables de entorno

# Carpetas base (ajustar según tu configuración)
VIDEO_BASE=Videos
AUDIO_BASE=audio
OUTPUT_BASE=CarpetaTranscripciones

# Configuración de procesamiento
LANGUAGE=es
MAX_CONCURRENT=3

# Funciones opcionales (true/false)
SEND_EMAIL=true
SEND_NOTION=false
PROCESS_BATCH=true
# Configuración para scan_and_process.py
# Copia este archivo a .env o configura estas variables de entorno

# Carpetas base (ajustar según tu configuración)
VIDEO_BASE=Videos
AUDIO_BASE=audio
OUTPUT_BASE=CarpetaTranscripciones

# Configuración de procesamiento
LANGUAGE=es
MAX_CONCURRENT=3

# Funciones opcionales (true/false)
SEND_EMAIL=true
SEND_NOTION=false
PROCESS_BATCH=true

# Variables para Notion (si se usa)
# NOTION_API_KEY=tu_api_key_aqui
# NOTION_DATABASE_ID=tu_database_id_aqui

# Variables para email (si se usa)
# EMAIL_SENDER=tu_email@gmail.com
# EMAIL_PASSWORD=tu_password_app
# EMAIL_RECEIVER=destinatario@gmail.com

# Rutas de Proyectos Externos (ajustar según tu entorno local)
CLIENT_A_PATH=C:\Dev\ClientProjects\ClientA
ZO_INTERVIEWS_PATH=C:\Dev\Zo\zo_portfolio\interviews

# Rutas de Entrada (Icecream Screen Recorder)
ICECREAM_MUSIC=C:\Users\%USERNAME%\Music\Icecream Screen Recorder
ICECREAM_VIDEOS=C:\Users\%USERNAME%\Videos\Icecream Screen Recorder

# Configuración de Extracción de Frames Clave
FRAME_EXTRACTION_ENABLED=true
KEYFRAME_METHOD=smart_scene          # iframe | scene | smart_scene | interval
FRAME_EXTRACTION_METHOD=smart_scene  # legacy alias (kept for compatibility)
FRAME_EXTRACTION_MAX_FRAMES=50
FRAME_EXTRACTION_MIN_VIDEO_SIZE_MB=30
FRAME_EXTRACTION_TUTORIAL_ONLY=false
FRAME_EXTRACTION_OUTPUT_DIR=Frames

# Smart Scene Tuning (new)
# Tutorial software: threshold=0.6, cooldown=3s, blur=3  (ignores cursor/UI micro-changes)
# Tutorial design/video: threshold=0.5, cooldown=5s, blur=2  (captures more subtle scene changes)
# Conference/lecture: threshold=0.55, cooldown=4s, blur=2   (balanced for slides + speaker)
SMART_SCENE_THRESHOLD=0.6            # 0.4-0.7; higher = fewer frames, ignores cursor
SMART_SCENE_COOLDOWN=3.0             # seconds between extracted frames
SMART_SCENE_BLUR=3                   # Gaussian blur sigma before scene detection

# Optimizaciones de calidad y rendimiento
FRAME_EXTRACTION_QUALITY=2  # 1-31, menor = mejor calidad
FRAME_EXTRACTION_LONG_VIDEO_MAX_FRAMES=50  # Para videos >2h
FRAME_EXTRACTION_INTERVAL_SECONDS=60  # Para método interval: segundos entre frames

LLM_API_KEY=your_api_key_here
LLM_MODEL=kimi-k2.6
LLM_BASE_URL=https://ollama.com/v1

FRAME_DESCRIPTIONS=false
FRAME_DESCRIPTION_MAX=20

WHISPER_MODEL=large-v3
CLEAN_TRANSCRIPTION=false
WORD_TIMESTAMPS=false
# ── Meeting Dev Handler ────────────────────────────────────────────────────
MEETING_FRAME_INTERVAL=15
MEETING_MAX_SCREEN_ANALYSES=30
# false = elimina imágenes después de analizar (solo queda context.md)
MEETING_KEEP_FRAMES=false
