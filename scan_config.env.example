# Configuration for the transcription pipeline.
# Copy this file to scan_config.env and adjust it for your local setup.
# scan_config.env is gitignored — never commit it with real values.

# ── Whisper transcription ───────────────────────────────────────────────
WHISPER_MODEL=large-v3
WORD_TIMESTAMPS=false
CLEAN_TRANSCRIPTION=false
KEYFRAMES_REQUIRED=true
KEYFRAME_METHOD=smart_scene          # iframe | scene | smart_scene | interval

# ── File tracking (idempotency, see FileTracker) ─────────────────────────
# fast = size+mtime+first-8KB fingerprint (cheap, default). full = SHA-256
# of the whole file (catches a content change that preserves size/mtime,
# meaningfully slower for large videos). Not a cryptographic integrity
# guarantee in either mode — see file_tracker.py's module docstring.
FILE_TRACKER_HASH_MODE=fast          # fast | full

# ── Video compression ───────────────────────────────────────────────────
VIDEO_COMPRESS_CRF=25                # 24-26 recommended (H.265)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── External source folders (Icecream Screen Recorder output) ──────────
ICECREAM_MUSIC=C:\Users\%USERNAME%\Music\Icecream Screen Recorder
ICECREAM_VIDEOS=C:\Users\%USERNAME%\Videos\Icecream Screen Recorder

# ── Smart Scene keyframe tuning ─────────────────────────────────────────
# Tutorial software: threshold=0.6, cooldown=3s, blur=3  (ignores cursor/UI micro-changes)
# Tutorial design/video: threshold=0.5, cooldown=5s, blur=2  (captures more subtle scene changes)
# Conference/lecture: threshold=0.55, cooldown=4s, blur=2   (balanced for slides + speaker)
SMART_SCENE_THRESHOLD=0.6            # 0.4-0.7; higher = fewer frames, ignores cursor
SMART_SCENE_COOLDOWN=3.0             # seconds between extracted frames
SMART_SCENE_BLUR=3                   # Gaussian blur sigma before scene detection

# ── Meeting dev handler ──────────────────────────────────────────────────
MEETING_FRAME_INTERVAL=15
MEETING_MAX_SCREEN_ANALYSES=30
MEETING_KEEP_FRAMES=false            # false = delete frame images after analysis (only context.md remains)

# ── Dashboard (see PRIVACY.md and docs/THREAT_MODEL.md) ─────────────────
# Binding anything other than 127.0.0.1/localhost exposes the dashboard —
# uploads, transcription edit/delete, pipeline run — to the whole network,
# with no authentication. Only do this on a trusted network you control.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
UPLOAD_MAX_MB=500

# ── Privacy / outbound AI (see PRIVACY.md) ───────────────────────────────
# Everything above runs 100% locally. The settings below are the only
# ones that can send data (transcript text, screenshots) off this machine,
# and only when explicitly turned on.
PRIVACY_MODE=local                   # local | cloud — informational, does not itself gate calls
ALLOW_EXTERNAL_LLM=false             # must be true for any remote LLM_BASE_URL to be called
ALLOW_FRAME_UPLOAD=false             # reserved for future frame-upload features
RETENTION_DAYS=0                     # 0 = keep local artifacts indefinitely

# LLM_PROVIDER_TYPE is usually auto-detected from LLM_BASE_URL (localhost/127.0.0.1
# = local, anything else = remote). Only set it explicitly if you're proxying a
# local endpoint through something that makes the URL misleading.
# LLM_PROVIDER_TYPE=remote
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

FRAME_DESCRIPTIONS=false             # send extracted video frames to the vision model (opt-in)
FRAME_DESCRIPTION_MAX=20
