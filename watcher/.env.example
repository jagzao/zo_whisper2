# Enhanced Watcher Service Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (PostgreSQL)
DATABASE_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whisper_transcription
POSTGRES_USER=whisper_user
POSTGRES_PASSWORD=whisper_secure_password_2024

# Service URLs (for microservices architecture)
TRANSCRIPTION_SERVICE_URL=http://transcription_service:9000
SUMMARY_SERVICE_URL=http://summary_service:9001

# Notion Integration
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Email Configuration
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here  
EMAIL_RECEIVER=recipient@gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Processing Configuration
LANGUAGE=es
MAX_FILE_SIZE_MB=500
CLEANUP_TEMP_FILES=true
PARALLEL_PROCESSING=true
MAX_CONCURRENT_JOBS=3

# Quality Settings for Transcription
TRANSCRIPTION_QUALITY=high
ENABLE_PREPROCESSING=true
ENABLE_NOISE_REDUCTION=true
ENABLE_POST_PROCESSING=true

# RAG Integration Paths (Optional)
RAG_BASE_PATH=C:/Dev/Triger/Automation/Rag/_transcripciones
SYNC_BASE_PATH=C:/Dev/Triger/SyncFileNotion/sync

# Performance Settings
ENABLE_REDIS_QUEUE=true
REDIS_URL=redis://redis:6379
ENABLE_FILE_MONITORING=true

# Automation Settings
ENABLE_AUTOMATION=true
ENABLE_WATCHDOG=true
ENABLE_CLEANUP=true
FILE_RETENTION_DAYS=30
DB_RETENTION_DAYS=90
TEMP_FILE_RETENTION_HOURS=24

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/app/logs/watcher.log

# Health Check Settings
HEALTH_CHECK_INTERVAL=30
FAILURE_THRESHOLD=3
RESTART_COOLDOWN=300

# Dashboard Settings
DASHBOARD_ENABLED=true
DASHBOARD_AUTO_REFRESH=30